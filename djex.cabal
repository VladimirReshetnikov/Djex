  Autogen-Modules: Paths_djex

  Build-Depends:
    filepath >= 1.4 && < 1.6,
    haskeline >= 0.8 && < 0.9,
    pqueue >= 1.3.1 && < 1.8,
    pretty >= 1.1 && < 1.2,
    process >= 1.6 && < 1.7

-- The shared interactive and one-shot command is a launcher over the library's
-- Language.Haskell.Djex.CLI, matching the two historical executables below,
-- which remain available for their compatibility contracts.
Executable djex
  import:         search-executable
  Main-Is:        Main.hs
  Hs-Source-Dirs: app
  Build-Depends:    djex

Test-Suite djex-tests
  import:         tasty-hunit-test, containers-dep
  Type:           exitcode-stdio-1.0
  Main-Is:        Spec.hs
  Hs-Source-Dirs: test-integration
  -- This integration suite deliberately crosses the stable facade, both raw
  -- search APIs, and the HSE compatibility API.
  Build-Depends:    djex

Test-Suite djex-cli-tests
  import:         cli-test
  Type:           exitcode-stdio-1.0
  Main-Is:        Spec.hs
  Hs-Source-Dirs: test-cli
  Build-Depends:    djex
  Build-Tool-Depends: djex:djex

Test-Suite synthesis-tests
  import:           tasty-hunit-test, tasty-quickcheck-dep, containers-dep, deepseq-dep
  Type:             exitcode-stdio-1.0
  Main-Is:          Spec.hs
  Hs-Source-Dirs:   synthesis/test
  Build-Depends:    djex

-- The one library exposes the historical Djinn facade, its core API, and the
-- checked adapter together.
Test-Suite djinn-frontend-api-tests
  import:         tasty-hunit-test
  Type:           exitcode-stdio-1.0
  Main-Is:        Spec.hs
  Hs-Source-Dirs: djinn/test-frontend-api
  Build-Depends:  djex

Executable djinn
  import:         search-executable
  Main-Is:        Main.hs
  Hs-Source-Dirs: djinn/app
  Build-Depends:  djex

Test-Suite djinn-tests
  import:         tasty-hunit-test, containers-dep
  Type:           exitcode-stdio-1.0
  Main-Is:        Spec.hs
  Hs-Source-Dirs: djinn/test-unit
  Other-Modules:
    HCheckCompatibility
    HKindCompatibility
    HTypeCompatibility
  Build-Depends:  djex

Test-Suite djinn-property-tests
  import:         tasty-test, tasty-quickcheck-dep
  Type:           exitcode-stdio-1.0
  Main-Is:        PropertySpec.hs
  Hs-Source-Dirs: djinn/test-property
  Build-Depends:  djex

Benchmark djinn-bench
  import:         tasty-benchmark
  Type:           exitcode-stdio-1.0
  Main-Is:        Bench.hs
  Other-Modules:  Corpus
  Hs-Source-Dirs: djinn/bench
  Build-Depends:  djex

Test-Suite djinn-cli-tests
  import:         cli-test
  Type:           exitcode-stdio-1.0
  Main-Is:        CLISpec.hs
  Hs-Source-Dirs: djinn/test-cli
  Build-Depends:  djex
  Build-Tool-Depends: djex:djinn

-- Exercise the curated facade and both lower-level engines through the single
-- downstream library dependency. AbstractionBoundary additionally pins the
-- opaque-constructor contract with deliberately rejected compile probes.
Test-Suite djex-api-tests
  import:         tasty-hunit-test, containers-dep
  Type:           exitcode-stdio-1.0
  Main-Is:        Spec.hs
  Hs-Source-Dirs: test-api
  Other-Modules:
    AbstractionBoundary
    ExferencePatternImports
    FacadeSpec
  Build-Depends:  djex

Benchmark exference-bench
  import:         tasty-benchmark
  Type:           exitcode-stdio-1.0
  Main-Is:        Bench.hs
  Other-Modules:  Corpus
  Hs-Source-Dirs: exference/bench
  Build-Depends:  djex

-- The single library exposes the historical Exference source APIs and the
-- checked adapter together; the executable remains only a launcher.
Test-Suite exference-frontend-api-tests
  import:         tasty-hunit-test
  Type:           exitcode-stdio-1.0
  Main-Is:        Spec.hs
  Hs-Source-Dirs: exference/test-frontend-api
  Build-Depends:  djex

Executable exference
  import:         search-executable
  Main-Is:        Main.hs
  Hs-Source-Dirs: exference/app
  Build-Depends:  djex

Test-Suite exference-tests
  import:          tasty-hunit-test, containers-dep, deepseq-dep, directory-dep, haskell-src-exts-dep, transformers-dep
  Type:            exitcode-stdio-1.0
  Main-Is:         Spec.hs
  Hs-Source-Dirs:  exference/test-unit
  Other-Modules:
    Paths_djex
    CompatibilityImport
    DeprecatedCompatibility
  Autogen-Modules: Paths_djex

  Build-Depends:    djex

Test-Suite exference-cli-tests
  import:         cli-test
  Type:           exitcode-stdio-1.0
  Main-Is:        CLISpec.hs
  Hs-Source-Dirs: exference/test-cli
  Build-Depends:  djex
  Build-Tool-Depends: djex:exference
