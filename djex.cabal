Cabal-Version: 3.0
Name:          djex
Version:       2026.7.12
Synopsis:      Haskell expression synthesis with Djinn and Exference backends
Description:
  Djex combines the Djinn intuitionistic theorem prover and the Exference
  heuristic polymorphic-expression search engine behind a shared,
  parser-independent synthesis foundation.
Category:      Language
License:       BSD-3-Clause
License-Files:
  synthesis/LICENSE
  djinn/LICENSE
  exference/LICENSE
Author:        Vladimir Reshetnikov, Lennart Augustsson, Lennart Spitzner, and contributors
Maintainer:    Vladimir Reshetnikov
Homepage:      https://github.com/VladimirReshetnikov/Haskell/tree/main/djex
Bug-Reports:   https://github.com/VladimirReshetnikov/Haskell/issues
Tested-With:
  GHC == 9.8.4,
  GHC == 9.12.4
Stability:     experimental
Copyright:
  Copyright (c) 2005-2014 Lennart Augustsson
  Copyright (C) 2014-2017 Lennart Spitzner
  Copyright (c) 2026 Vladimir Reshetnikov

Extra-Source-Files:
  README.md
  synthesis/README.md
  djinn/README.md
  djinn/docs/reports/*.md
  exference/README.md
  exference/docs/reports/*.md
  exference/docs/hcar/*.tex
  exference/exference.pdf
  exference/notes.txt

Data-Files:
  exference/environment/*.hs
  exference/environment/*.ratings

source-repository head
  type:     git
  location: https://github.com/VladimirReshetnikov/Haskell
  subdir:   djex

common build-settings
  Default-Language: Haskell2010
  Ghc-Options:
    -Wall
    -Wcompat
    -Wincomplete-record-updates
    -Wpartial-fields
    -Wunused-packages
  Build-Depends:    base >= 4.19 && < 5

-- Keep the most widely shared dependency bounds in one place without making
-- components depend on packages they do not import.
common containers-dep
  Build-Depends: containers >= 0.6 && < 0.9

common deepseq-dep
  Build-Depends: deepseq >= 1.4 && < 1.6

common directory-dep
  Build-Depends: directory >= 1.3 && < 1.4

common haskell-src-exts-dep
  Build-Depends: haskell-src-exts >= 1.24 && < 1.25

common transformers-dep
  Build-Depends: transformers >= 0.5 && < 0.7

common tasty-quickcheck-dep
  Build-Depends: tasty-quickcheck >= 0.10 && < 1

-- Cabal restricts common stanzas to build-information fields, so each test
-- suite still declares its interface locally.
common tasty-test
  import:        build-settings
  -- 1.4.2 is the first release whose bundled async fallback adapts to the
  -- monomorphic fork# primop used by GHC 9.12 (tasty commit 4dd33d5c).
  Build-Depends: tasty >= 1.4.2 && < 2

common tasty-hunit-test
  import:        tasty-test
  Build-Depends: tasty-hunit >= 0.10 && < 1

common cli-test
  import:        tasty-hunit-test, directory-dep
  Build-Depends: process >= 1.6 && < 1.7

-- Every backend library consumes the neutral synthesis vocabulary and
-- transformers; both parser-independent cores also use containers. Keep
-- algorithm- and frontend-specific packages local so this stanza records only
-- the components' actual dependency intersection.
common backend-library
  import:        build-settings, transformers-dep
  Build-Depends: djex:synthesis

common backend-core
  import: backend-library, containers-dep

-- The stable Djex facade. Compatibility and research modules remain available
-- from their explicit named sublibraries instead of leaking into every Djex
-- client. The adapters expose checked parser-neutral session and query entry
-- points; source loading remains an explicit frontend dependency.
Library
  import:           build-settings
  Hs-Source-Dirs:   src

  Exposed-Modules:
    Language.Haskell.Djex

  Reexported-Modules:
    Language.Haskell.Djex.Djinn,
    Language.Haskell.Djex.Exference,
    Language.Haskell.Synthesis.Candidate,
    Language.Haskell.Synthesis.Constraint,
    Language.Haskell.Synthesis.Declaration,
    Language.Haskell.Synthesis.Diagnostic,
    Language.Haskell.Synthesis.Environment,
    Language.Haskell.Synthesis.Generated,
    Language.Haskell.Synthesis.Kind,
    Language.Haskell.Synthesis.KindInference,
    Language.Haskell.Synthesis.Inventory,
    Language.Haskell.Synthesis.Name,
    Language.Haskell.Synthesis.Query,
    Language.Haskell.Synthesis.Search,
    Language.Haskell.Synthesis.Selection,
    Language.Haskell.Synthesis.Type,
    Language.Haskell.Synthesis.TypeSynonym,
    Language.Haskell.Synthesis.TypeRender

  Build-Depends:
    djex:synthesis,
    djex:djinn-core,
    djex:exference-core

-- The merged one-shot command consumes only the checked public facade. The
-- historical executables below remain available for their REPL and legacy
-- compatibility contracts.
Executable djex
  import:         build-settings
  Main-Is:        Main.hs
  Hs-Source-Dirs: app
  Other-Modules:
    Djex.Driver
    Paths_djex
  Autogen-Modules: Paths_djex
  Build-Depends:
    djex,
    djex:exference-frontend

Library synthesis
  import:           build-settings, containers-dep, deepseq-dep, transformers-dep
  Visibility:       public
  Hs-Source-Dirs:   synthesis/src

  Exposed-Modules:
    Language.Haskell.Synthesis.Candidate
    Language.Haskell.Synthesis.Constraint
    Language.Haskell.Synthesis.Declaration
    Language.Haskell.Synthesis.Diagnostic
    Language.Haskell.Synthesis.Environment
    Language.Haskell.Synthesis.Generated
    Language.Haskell.Synthesis.Kind
    Language.Haskell.Synthesis.KindInference
    Language.Haskell.Synthesis.Inventory
    Language.Haskell.Synthesis.Name
    Language.Haskell.Synthesis.Query
    Language.Haskell.Synthesis.Search
    Language.Haskell.Synthesis.Selection
    Language.Haskell.Synthesis.Type
    Language.Haskell.Synthesis.TypeSynonym
    Language.Haskell.Synthesis.TypeRender

  Build-Depends:
    pretty >= 1.1 && < 1.2

Test-Suite djex-tests
  import:         tasty-hunit-test, containers-dep
  Type:           exitcode-stdio-1.0
  Main-Is:        Spec.hs
  Hs-Source-Dirs: test-integration
  -- This integration suite deliberately constructs raw Exference fixtures.
  -- Facade-only clients do not acquire the research core transitively.
  Build-Depends:
    djex,
    djex:djinn-core,
    djex:exference-core,
    djex:exference-frontend

-- Compile and exercise the single-import surface independently of the raw
-- backend fixture suite above. This catches accidental facade type leaks.
Test-Suite djex-facade-tests
  import:         tasty-hunit-test
  Type:           exitcode-stdio-1.0
  Main-Is:        Spec.hs
  Hs-Source-Dirs: test-facade
  Build-Depends:  djex

Test-Suite djex-cli-tests
  import:         cli-test
  Type:           exitcode-stdio-1.0
  Main-Is:        Spec.hs
  Hs-Source-Dirs: test-cli
  Build-Tool-Depends: djex:djex

Test-Suite synthesis-tests
  import:           tasty-hunit-test, tasty-quickcheck-dep, containers-dep, deepseq-dep
  Type:             exitcode-stdio-1.0
  Main-Is:          Spec.hs
  Hs-Source-Dirs:   synthesis/test
  Build-Depends:    djex:synthesis

Library djinn-core
  import:           backend-core
  Visibility:       public
  Hs-Source-Dirs:   djinn/src-core

  -- Djinn.Core is the stable library API.  Raw proof/search modules remain
  -- exposed for the compatibility frontend, tests, and benchmark, without
  -- stability or invariant guarantees.  The checked shared-IR adapters are
  -- exported through Djinn.Core; their implementation modules stay private.
  Exposed-Modules:
    Djinn.Core
    Language.Haskell.Djex.Djinn
    Djinn.Internal.Environment
    Djinn.Internal.Generated
    Djinn.Internal.HCheck
    Djinn.Internal.HIdentifier
    Djinn.Internal.HTypes
    Djinn.Internal.LJT
    Djinn.Internal.LJTFormula
    Djinn.Internal.ProofCheck
    Djinn.Internal.ProofEnv

  Other-Modules:
    Djinn.Internal.Declaration
    Djinn.Internal.Type

-- Compatibility frontend for the historical Djinn library.  Cabal component
-- names are package-wide, so this cannot share the `djinn` executable's name.
Library djinn-frontend
  import:           backend-library
  Visibility:       public
  Hs-Source-Dirs:   djinn/src-frontend

  Build-Depends:
    djex:djinn-core,
    haskeline >= 0.8 && < 0.9

  Exposed-Modules: Djinn
  Reexported-Modules:
    Djinn.Core,
    Language.Haskell.Djex.Djinn

  Other-Modules:
    Djinn.Internal.Help
    Djinn.Internal.REPL
    Paths_djex
  Autogen-Modules: Paths_djex

-- A compatibility dependency must expose both the historical core facade and
-- the checked Djex adapter without requiring a second direct dependency.
Test-Suite djinn-frontend-api-tests
  import:         tasty-hunit-test
  Type:           exitcode-stdio-1.0
  Main-Is:        Spec.hs
  Hs-Source-Dirs: djinn/test-frontend-api
  Build-Depends:  djex:djinn-frontend

Executable djinn
  import:         build-settings
  Main-Is:        Main.hs
  Hs-Source-Dirs: djinn/app
  Build-Depends:  djex:djinn-frontend

Test-Suite djinn-tests
  import:         tasty-hunit-test, containers-dep
  Type:           exitcode-stdio-1.0
  Main-Is:        Spec.hs
  Hs-Source-Dirs: djinn/test-unit
  Build-Depends:
    djex:djinn-core,
    djex:synthesis

Test-Suite djinn-property-tests
  import:         tasty-test, tasty-quickcheck-dep
  Type:           exitcode-stdio-1.0
  Main-Is:        PropertySpec.hs
  Hs-Source-Dirs: djinn/test-property
  Build-Depends:  djex:djinn-core

Benchmark djinn-bench
  import:         build-settings
  Type:           exitcode-stdio-1.0
  Main-Is:        Bench.hs
  Other-Modules:  Corpus
  Hs-Source-Dirs: djinn/bench
  Build-Depends:
    djex:djinn-core,
    tasty-bench >= 0.3 && < 0.6

Test-Suite djinn-cli-tests
  import:         cli-test
  Type:           exitcode-stdio-1.0
  Main-Is:        CLISpec.hs
  Hs-Source-Dirs: djinn/test-cli
  Build-Tool-Depends: djex:djinn

Library exference-core
  import:         backend-core, deepseq-dep
  Visibility:     public
  -- Preserve the historical search-core optimization policy across the raw
  -- engine and its parser-neutral stable adapter. HSE frontend and executable
  -- code use the package-wide defaults.
  Ghc-Options:    -fno-spec-constr
  Hs-Source-Dirs: exference/src-core

  Exposed-Modules:
    Language.Haskell.Djex.Exference
    Language.Haskell.Djex.Exference.FrontendSupport
    Language.Haskell.Exference
    Language.Haskell.Exference.Diagnostic
    Language.Haskell.Exference.SimpleDict
    Language.Haskell.Exference.Core
    Language.Haskell.Exference.Core.Name
    Language.Haskell.Exference.Core.Types
    Language.Haskell.Exference.Core.TypeUtils
    Language.Haskell.Exference.Core.RigidInstantiation
    Language.Haskell.Exference.Core.ExferenceStats
    Language.Haskell.Exference.Core.Candidate
    Language.Haskell.Exference.Core.ConstraintSolver
    Language.Haskell.Exference.Core.Declaration
    Language.Haskell.Exference.Core.Unify
    Language.Haskell.Exference.Core.Expression
    Language.Haskell.Exference.Core.ExpressionCheck
    Language.Haskell.Exference.Core.ExpressionSimplify
    Language.Haskell.Exference.Core.FunctionBinding
    Language.Haskell.Exference.Core.Score
    Language.Haskell.Exference.Core.Internal.Scope

  Other-Modules:
    Language.Haskell.Djex.Exference.Internal.Request
    Language.Haskell.Djex.Exference.Internal.Session
    Language.Haskell.Exference.Core.Internal.FlexibleIds
    Language.Haskell.Exference.Core.Internal.Unify
    Language.Haskell.Exference.Core.Internal.ConstraintSolver
    Language.Haskell.Exference.Core.Internal.Candidate
    Language.Haskell.Exference.Core.Internal.Closure
    Language.Haskell.Exference.Core.Internal.ExferenceNode
    Language.Haskell.Exference.Core.Internal.ExferenceNodeBuilder
    Language.Haskell.Exference.Core.Internal.Exference

  Build-Depends:
    pqueue >= 1.3.1 && < 1.8

-- This suite deliberately sees only the parser-neutral component. It guards
-- the stable adapter against accidental HSE or filesystem dependencies.
Test-Suite exference-core-api-tests
  import:         tasty-hunit-test
  Type:           exitcode-stdio-1.0
  Main-Is:        Spec.hs
  Hs-Source-Dirs: exference/test-core-api
  Build-Depends:
    djex:exference-core,
    djex:synthesis

-- Compatibility frontend for the historical Exference library.  Cabal
-- component names are package-wide, so this cannot share the `exference`
-- executable's name.
Library exference-frontend
  import:         backend-library, containers-dep, deepseq-dep, directory-dep, haskell-src-exts-dep
  Visibility:     public
  Hs-Source-Dirs: exference/src-frontend

  Exposed-Modules:
    Language.Haskell.Djex.Exference.HaskellSrc
    Language.Haskell.Exference.CLI
    Language.Haskell.Exference.ExpressionToHaskellSrc
    Language.Haskell.Exference.TypeFromHaskellSrc
    Language.Haskell.Exference.TypeDeclsFromHaskellSrc
    Language.Haskell.Exference.BindingsFromHaskellSrc
    Language.Haskell.Exference.ClassEnvFromHaskellSrc
    Language.Haskell.Exference.EnvironmentParser
    Language.Haskell.Exference.Session

  Reexported-Modules:
    Language.Haskell.Djex.Exference,
    Language.Haskell.Exference,
    Language.Haskell.Exference.Diagnostic,
    Language.Haskell.Exference.SimpleDict,
    Language.Haskell.Exference.Core,
    Language.Haskell.Exference.Core.Name,
    Language.Haskell.Exference.Core.Types,
    Language.Haskell.Exference.Core.TypeUtils,
    Language.Haskell.Exference.Core.RigidInstantiation,
    Language.Haskell.Exference.Core.ExferenceStats,
    Language.Haskell.Exference.Core.Candidate,
    Language.Haskell.Exference.Core.ConstraintSolver,
    Language.Haskell.Exference.Core.Declaration,
    Language.Haskell.Exference.Core.Unify,
    Language.Haskell.Exference.Core.Expression,
    Language.Haskell.Exference.Core.ExpressionCheck,
    Language.Haskell.Exference.Core.ExpressionSimplify,
    Language.Haskell.Exference.Core.FunctionBinding,
    Language.Haskell.Exference.Core.Score

  Other-Modules:
    Language.Haskell.Exference.HaskellSrcUtils
    Paths_djex
  Autogen-Modules: Paths_djex

  Build-Depends:
    djex:exference-core,
    filepath >= 1.4 && < 1.6

-- Keep the compatibility command implementation in the frontend component;
-- the executable below is deliberately only a launcher for this public API.
Test-Suite exference-frontend-api-tests
  import:         tasty-hunit-test
  Type:           exitcode-stdio-1.0
  Main-Is:        Spec.hs
  Hs-Source-Dirs: exference/test-frontend-api
  Build-Depends:  djex:exference-frontend

Executable exference
  import:         build-settings
  Main-Is:        Main.hs
  Hs-Source-Dirs: exference/app
  Build-Depends:  djex:exference-frontend

  -- Search is serial. Permit explicit caller tuning without inheriting the
  -- historical multi-gigabyte heap hint or starting one capability per core.
  Ghc-Options: -rtsopts

Test-Suite exference-tests
  import:          tasty-hunit-test, containers-dep, deepseq-dep, directory-dep, haskell-src-exts-dep, transformers-dep
  Type:            exitcode-stdio-1.0
  Main-Is:         Spec.hs
  Hs-Source-Dirs:  exference/test-unit
  Other-Modules:
    Paths_djex
    CompatibilityImport
    DeprecatedCompatibility
  Autogen-Modules: Paths_djex

  Build-Depends:
    djex:exference-frontend,
    djex:exference-core,
    djex:synthesis

Test-Suite exference-cli-tests
  import:         cli-test
  Type:           exitcode-stdio-1.0
  Main-Is:        CLISpec.hs
  Hs-Source-Dirs: exference/test-cli
  Build-Tool-Depends: djex:exference
