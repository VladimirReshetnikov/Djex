Cabal-Version: 3.0
Name:          djex
Version:       2026.7.17
Synopsis:      Haskell expression synthesis with Djinn and Exference backends
Description:
  Djex combines the Djinn intuitionistic theorem prover and the Exference
  heuristic polymorphic-expression search engine behind a shared,
  parser-independent synthesis foundation and one library contract.
Category:      Language
License:       BSD-3-Clause
License-Files:
  LICENSE
  djinn/LICENSE
  exference/LICENSE
Author:        Vladimir Reshetnikov, Lennart Augustsson, Lennart Spitzner, and contributors
Maintainer:    Vladimir Reshetnikov
Homepage:      https://github.com/VladimirReshetnikov/Djex
Bug-Reports:   https://github.com/VladimirReshetnikov/Djex/issues
Tested-With:   GHC == 9.12.4
Stability:     experimental
Copyright:
  Copyright (c) 2005-2014 Lennart Augustsson
  Copyright (C) 2014-2017 Lennart Spitzner
  Copyright (c) 2026 Djex Contributors

Extra-Doc-Files:
  README.md
  docs/*.md
  synthesis/README.md
  djinn/README.md
  exference/README.md

Extra-Source-Files:
  docs/reports/*.md
  djinn/docs/reports/*.md
  exference/docs/reports/*.md
  exference/docs/hcar/*.tex
  exference/notes.txt

Data-Files:
  exference/environment/*.hs
  exference/environment/*.ratings

source-repository head
  type:     git
  location: https://github.com/VladimirReshetnikov/Djex

common build-settings
  Default-Language: Haskell2010
  Ghc-Options:
    -Wall
    -Wcompat
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints
    -Wunused-packages
  -- The package supports only GHC 9.12.4. Tested-With carries the exact
  -- compiler identity; this is the base API line bundled with that toolchain.
  Build-Depends:    base == 4.21.2.*

-- All three search commands remain serial, but callers may explicitly tune
-- ordinary RTS resource limits when a large search needs them.
common search-executable
  import:      build-settings
  Ghc-Options: -rtsopts

-- Keep the most widely shared dependency bounds in one place without making
-- components depend on packages they do not import.
common containers-dep
  Build-Depends: containers >= 0.6 && < 0.9

common deepseq-dep
  Build-Depends: deepseq >= 1.4 && < 1.6

common directory-dep
  Build-Depends: directory >= 1.3 && < 1.4

common haskell-src-exts-dep
  Build-Depends: haskell-src-exts >= 1.24 && < 1.25

common transformers-dep
  Build-Depends: transformers >= 0.5 && < 0.7

common tasty-quickcheck-dep
  Build-Depends: tasty-quickcheck >= 0.10 && < 1

common tasty-benchmark
  import:        build-settings
  Build-Depends: tasty-bench >= 0.3 && < 0.6

-- Cabal restricts common stanzas to build-information fields, so each test
-- suite still declares its interface locally.
common tasty-test
  import:        build-settings
  -- 1.4.2 is the first release whose bundled async fallback adapts to the
  -- monomorphic fork# primop used by GHC 9.12 (tasty commit 4dd33d5c).
  Build-Depends: tasty >= 1.4.2 && < 2

common tasty-hunit-test
  import:        tasty-test
  Build-Depends: tasty-hunit >= 0.10 && < 1

common cli-test
  import:        tasty-hunit-test, directory-dep
  Build-Depends: process >= 1.6 && < 1.7
  -- Output assertions shared by the three CLI subprocess suites.
  Hs-Source-Dirs: test-support
  Other-Modules:  CLIAssertions

-- The single Djex library. The directory split records implementation
-- provenance and keeps parser-independent modules honest at the Haskell import
-- level; it is no longer a second package-component architecture. Clients get
-- the shared foundation, both engines, source loading, and both compatibility
-- APIs through one dependency and one version contract.
Library
  import:           build-settings, containers-dep, deepseq-dep, directory-dep, haskell-src-exts-dep, transformers-dep
  Hs-Source-Dirs:
    src
    synthesis/src
    djinn/src-core
    djinn/src-frontend
    exference/src-core
    exference/src-frontend

  Exposed-Modules:
    Language.Haskell.Djex
    Language.Haskell.Djex.CLI
    Language.Haskell.Djex.REPL
    Language.Haskell.Djex.Djinn
    Language.Haskell.Djex.Exference
