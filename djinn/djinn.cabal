Cabal-version:  3.0
Name:           djinn
Version:        2026.7.11
Synopsis:       Generate Haskell code from a type
Description:    Djinn uses a theorem prover for intuitionistic propositional logic
                to generate a Haskell expression when given a type.
Bug-reports:    https://github.com/VladimirReshetnikov/Haskell/issues
License:        BSD-3-Clause
License-File:   LICENSE
Author:         Lennart Augustsson
Maintainer:     Vladimir Reshetnikov
Homepage:       https://github.com/VladimirReshetnikov/Haskell/tree/main/djex/djinn
Copyright:      2014 Lennart Augustsson
Category:       source-tools
Build-type:     Simple
Stability:      experimental
Extra-Source-Files:
                README.md
                docs/reports/*.md

source-repository head
  type:     git
  location: https://github.com/VladimirReshetnikov/Haskell
  subdir:   djex/djinn

common build-settings
  Default-Language: Haskell2010
  Ghc-Options:      -Wall -Wcompat
  Build-Depends:    base >= 4.19 && < 5

library djinn-core
  import:           build-settings
  Visibility:       public
  Hs-Source-Dirs:   src

  Build-Depends:    haskell-synthesis >= 0.1.12 && < 0.2,
                    transformers >= 0.5 && < 0.7,
                    containers >= 0.6 && < 0.9

  -- Djinn.Core is the stable library API.  The core Djinn.Internal.*
  -- modules expose raw machinery without stability or invariant guarantees;
  -- see the README's library section.
  Exposed-Modules:  Djinn.Core,
                    Djinn.Internal.Environment,
                    Djinn.Internal.Declaration,
                    Djinn.Internal.Generated,
                    Djinn.Internal.HCheck,
                    Djinn.Internal.HIdentifier,
                    Djinn.Internal.HTypes,
                    Djinn.Internal.LJT,
                    Djinn.Internal.LJTFormula,
                    Djinn.Internal.ProofCheck,
                    Djinn.Internal.ProofEnv,
                    Djinn.Internal.Type

library
  import:           build-settings
  Hs-Source-Dirs:   src-cli

  Build-Depends:    djinn:djinn-core,
                    haskeline >= 0.8 && < 0.9,
                    transformers >= 0.5 && < 0.7

  -- The main library is the CLI facade.  Re-exporting Djinn.Core lets
  -- consumers choose either `djinn` or the smaller `djinn-core` component
  -- without changing their stable API imports.
  Exposed-Modules:    Djinn
  Reexported-Modules: Djinn.Core

  Other-Modules:    Djinn.Internal.Help,
                    Djinn.Internal.REPL,
                    Paths_djinn
  Autogen-Modules:  Paths_djinn

executable djinn
  import:         build-settings
  Main-Is:        Main.hs

  Build-Depends:  djinn

  Hs-Source-Dirs: app

test-suite djinn-tests
  import:           build-settings
  Type:             exitcode-stdio-1.0
  Main-Is:          Spec.hs
  Hs-Source-Dirs:   test
  Build-Depends:    containers >= 0.6 && < 0.9,
                    djinn:djinn-core,
                    haskell-synthesis >= 0.1.12 && < 0.2,
                    tasty >= 1.4 && < 2,
                    tasty-hunit >= 0.10 && < 1

test-suite djinn-property-tests
  import:           build-settings
  Type:             exitcode-stdio-1.0
  Main-Is:          PropertySpec.hs
  Hs-Source-Dirs:   test
  Build-Depends:    djinn:djinn-core,
                    tasty >= 1.4 && < 2,
                    tasty-quickcheck >= 0.10 && < 1

benchmark djinn-bench
  import:           build-settings
  Type:             exitcode-stdio-1.0
  Main-Is:          Bench.hs
  Other-Modules:    Corpus
  Hs-Source-Dirs:   bench
  Build-Depends:    djinn:djinn-core,
                    tasty-bench >= 0.3 && < 0.6

test-suite djinn-cli-tests
  import:             build-settings
  Type:               exitcode-stdio-1.0
  Main-Is:            CLISpec.hs
  Hs-Source-Dirs:     test
  Build-Depends:      process >= 1.6 && < 1.7,
                      tasty >= 1.4 && < 2,
                      tasty-hunit >= 0.10 && < 1

  Build-Tool-Depends: djinn:djinn
