Cabal-version:  3.0
Name:           djinn
Version:        2025.2.21
Synopsis:       Generate Haskell code from a type
Description:    Djinn uses a theorem prover for intuitionistic propositional logic
                to generate a Haskell expression when given a type.
Bug-reports:    https://github.com/augustss/djinn/issues
License:        BSD-3-Clause
License-File:   LICENSE
Author:         Lennart Augustsson
Maintainer:     Lennart Augustsson
Copyright:      2014 Lennart Augustsson
Category:       source-tools
Build-type:     Simple
Stability:      experimental
Extra-Source-Files:
                README.md
                docs/reports/*.md

source-repository head
  type:     git
  location: https://github.com/augustss/djinn

executable djinn
  Default-Language: Haskell98
  Main-Is:        Djinn.hs
  Ghc-Options:    -Wall -Wcompat

  Build-Depends:  base >= 4 && < 6,
                  mtl < 10,
                  haskeline < 10,
                  pretty < 10,
                  containers < 10

  Other-modules:  Environment, Help, HCheck, HIdentifier, HTypes, LJT,
                  LJTFormula, Paths_djinn,
                  ProofCheck, ProofEnv, REPL
  Autogen-Modules: Paths_djinn

  Hs-Source-Dirs: src

test-suite djinn-tests
  Type:             exitcode-stdio-1.0
  Main-Is:          Spec.hs
  Hs-Source-Dirs:   test, src
  Default-Language: Haskell2010
  Ghc-Options:      -Wall -Wcompat

  Build-Depends:    base >= 4 && < 6,
                    mtl < 10,
                    pretty < 10,
                    containers < 10,
                    tasty >= 1.4 && < 2,
                    tasty-hunit >= 0.10 && < 1

  Other-Modules:    Environment,
                    HCheck,
                    HIdentifier,
                    HTypes,
                    LJT,
                    LJTFormula,
                    ProofCheck,
                    ProofEnv

test-suite djinn-property-tests
  Type:             exitcode-stdio-1.0
  Main-Is:          PropertySpec.hs
  Hs-Source-Dirs:   test, src
  Default-Language: Haskell2010
  Ghc-Options:      -Wall -Wcompat

  Build-Depends:    base >= 4 && < 6,
                    containers < 10,
                    mtl < 10,
                    pretty < 10,
                    QuickCheck >= 2.14 && < 3,
                    tasty >= 1.4 && < 2,
                    tasty-quickcheck >= 0.10 && < 1

  Other-Modules:    HIdentifier,
                    HTypes,
                    LJT,
                    LJTFormula,
                    ProofCheck

test-suite djinn-cli-tests
  Type:               exitcode-stdio-1.0
  Main-Is:            CLISpec.hs
  Hs-Source-Dirs:     test
  Default-Language:   Haskell2010
  Ghc-Options:        -Wall -Wcompat

  Build-Depends:      base >= 4 && < 6,
                      process < 2,
                      tasty >= 1.4 && < 2,
                      tasty-hunit >= 0.10 && < 1

  Build-Tool-Depends: djinn:djinn
