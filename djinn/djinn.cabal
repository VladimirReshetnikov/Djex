Cabal-version:  3.0
Name:           djinn
Version:        2025.2.21
Synopsis:       Generate Haskell code from a type
Description:    Djinn uses a theorem prover for intuitionistic propositional logic
                to generate a Haskell expression when given a type.
Bug-reports:    https://github.com/augustss/djinn/issues
License:        BSD-3-Clause
License-File:   LICENSE
Author:         Lennart Augustsson
Maintainer:     Lennart Augustsson
Copyright:      2014 Lennart Augustsson
Category:       source-tools
Build-type:     Simple
Stability:      experimental
Extra-Source-Files:
                README.md
                docs/reports/*.md

source-repository head
  type:     git
  location: https://github.com/augustss/djinn

library djinn-core
  Default-Language: Haskell98
  Hs-Source-Dirs:   src
  Ghc-Options:      -Wall -Wcompat

  Build-Depends:    base >= 4 && < 6,
                    haskeline < 10,
                    mtl < 10,
                    pretty < 10,
                    containers < 10

  Exposed-Modules:  Djinn,
                    Environment,
                    HCheck,
                    HIdentifier,
                    HTypes,
                    LJT,
                    LJTFormula,
                    ProofCheck,
                    ProofEnv

  Other-Modules:    Help,
                    REPL,
                    Paths_djinn
  Autogen-Modules:  Paths_djinn

executable djinn
  Default-Language: Haskell98
  Main-Is:        Main.hs
  Ghc-Options:    -Wall -Wcompat

  Build-Depends:  base >= 4 && < 6,
                  djinn:djinn-core

  Hs-Source-Dirs: app

test-suite djinn-tests
  Type:             exitcode-stdio-1.0
  Main-Is:          Spec.hs
  Hs-Source-Dirs:   test
  Default-Language: Haskell2010
  Ghc-Options:      -Wall -Wcompat

  Build-Depends:    base >= 4 && < 6,
                    djinn:djinn-core,
                    tasty >= 1.4 && < 2,
                    tasty-hunit >= 0.10 && < 1

test-suite djinn-property-tests
  Type:             exitcode-stdio-1.0
  Main-Is:          PropertySpec.hs
  Hs-Source-Dirs:   test
  Default-Language: Haskell2010
  Ghc-Options:      -Wall -Wcompat

  Build-Depends:    base >= 4 && < 6,
                    QuickCheck >= 2.14 && < 3,
                    djinn:djinn-core,
                    tasty >= 1.4 && < 2,
                    tasty-quickcheck >= 0.10 && < 1

benchmark djinn-bench
  Type:             exitcode-stdio-1.0
  Main-Is:          Bench.hs
  Other-Modules:    Corpus
  Hs-Source-Dirs:   bench
  Default-Language: Haskell2010
  Ghc-Options:      -Wall -Wcompat

  Build-Depends:    base >= 4 && < 6,
                    djinn:djinn-core,
                    tasty-bench >= 0.3 && < 0.5

test-suite djinn-cli-tests
  Type:               exitcode-stdio-1.0
  Main-Is:            CLISpec.hs
  Hs-Source-Dirs:     test
  Default-Language:   Haskell2010
  Ghc-Options:        -Wall -Wcompat

  Build-Depends:      base >= 4 && < 6,
                      process < 2,
                      tasty >= 1.4 && < 2,
                      tasty-hunit >= 0.10 && < 1

  Build-Tool-Depends: djinn:djinn
