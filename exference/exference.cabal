source-repository head {
  type: git
  location: git@github.com:lspitzner/exference.git
}



Flag exference-dev
  default: False
  manual: True

Library exference-core
  default-language: Haskell2010
  ghc-options: -Wall
               -fno-warn-orphans
               -fno-spec-constr
  if impl(ghc > 8.0)
    ghc-options: -fno-warn-redundant-constraints
  if flag(exference-dev)
    ghc-options: -Werror
                 -auto-all
                 -caf-all
  exposed-modules: Language.Haskell.Exference.Core
                   Language.Haskell.Exference.Core.Types
                   Language.Haskell.Exference.Core.TypeUtils
                   Language.Haskell.Exference.Core.ExferenceStats
                   Language.Haskell.Exference.Core.ConstraintSolver
                   Language.Haskell.Exference.Core.Unify
                   Language.Haskell.Exference.Core.Expression
                   Language.Haskell.Exference.Core.ExpressionCheck
                   Language.Haskell.Exference.Core.ExpressionSimplify
                   Language.Haskell.Exference.Core.FunctionBinding
                   Language.Haskell.Exference.Core.Score
  other-modules:   Language.Haskell.Exference.Core.Internal.Unify,
                   Language.Haskell.Exference.Core.Internal.ConstraintSolver,
                   Language.Haskell.Exference.Core.Internal.Closure,
                   Language.Haskell.Exference.Core.Internal.ExferenceNode,
                   Language.Haskell.Exference.Core.Internal.ExferenceNodeBuilder,
                   Language.Haskell.Exference.Core.Internal.Exference
  default-extensions: NoMonomorphismRestriction
                   FlexibleContexts
                   ScopedTypeVariables
                   DeriveDataTypeable
                   TemplateHaskell
  hs-source-dirs: src-core
  Build-Depends:
    base                 >=4.18 && <5,
    containers           >=0.6 && <0.9,
    pretty               >=1.1 && <1.2,
    deepseq              >=1.4 && <1.6,
    deepseq-generics     >=0.1.1.2 && <0.3,
    pqueue               >=1.3.1 && <1.8,
    mmorph               >=1.0.4 && <1.3,
    transformers         >=0.5 && <0.7,
    mtl                  >=2.2 && <2.4,
    vector               >=0.12 && <0.14,
    safe                 >=0.3.9 && <0.4,
    lens                 >=5.0 && <5.4,
    multistate           >=0.8 && <0.9

-- The unnamed library is the source-syntax and environment-loading frontend.
-- Keep it above the search core so future frontends can depend on
-- exference-core without pulling in haskell-src-exts or filesystem concerns.
Library
  default-language: Haskell2010
  ghc-options: -Wall
               -fno-warn-orphans
               -fno-spec-constr
  if impl(ghc > 8.0)
    ghc-options: -fno-warn-redundant-constraints
  if flag(exference-dev)
    ghc-options: -Werror
                 -auto-all
                 -caf-all
  exposed-modules: Language.Haskell.Exference
                   Language.Haskell.Exference.Diagnostic
                   Language.Haskell.Exference.SimpleDict
                   Language.Haskell.Exference.ExpressionToHaskellSrc
                   Language.Haskell.Exference.TypeFromHaskellSrc
                   Language.Haskell.Exference.TypeDeclsFromHaskellSrc
                   Language.Haskell.Exference.BindingsFromHaskellSrc
                   Language.Haskell.Exference.ClassEnvFromHaskellSrc
                   Language.Haskell.Exference.EnvironmentParser
                   Language.Haskell.Exference.FunctionDecl
                   Paths_exference
  reexported-modules:
    Language.Haskell.Exference.Core,
    Language.Haskell.Exference.Core.Types,
    Language.Haskell.Exference.Core.TypeUtils,
    Language.Haskell.Exference.Core.ExferenceStats,
    Language.Haskell.Exference.Core.ConstraintSolver,
    Language.Haskell.Exference.Core.Unify,
    Language.Haskell.Exference.Core.Expression,
    Language.Haskell.Exference.Core.ExpressionCheck,
    Language.Haskell.Exference.Core.ExpressionSimplify,
    Language.Haskell.Exference.Core.FunctionBinding,
    Language.Haskell.Exference.Core.Score
  autogen-modules: Paths_exference
  other-modules:   Language.Haskell.Exference.HaskellSrcUtils
  default-extensions: NoMonomorphismRestriction
                   FlexibleContexts
                   ScopedTypeVariables
                   DeriveDataTypeable
                   TemplateHaskell
  hs-source-dirs: src
  Build-Depends:
    base                 >=4.18 && <5,
    exference:exference-core,
    containers           >=0.6 && <0.9,
    deepseq              >=1.4 && <1.6,
    transformers         >=0.5 && <0.7,
    mtl                  >=2.2 && <2.4,
    haskell-src-exts     >=1.24 && <1.25,
    directory            >=1.3 && <1.4,
    split                >=0.2.3.1 && <0.3,
    multistate           >=0.8 && <0.9


Executable exference
  default-language: Haskell2010
  build-depends:
    base                 >=4.18 && <5,
    exference,
    containers           >=0.6 && <0.9,
    deepseq              >=1.4 && <1.6,
    transformers         >=0.5 && <0.7,
    mtl                  >=2.2 && <2.4,
    haskell-src-exts     >=1.24 && <1.25,
    multistate           >=0.8 && <0.9

  other-modules: MainConfig
                 Paths_exference
  autogen-modules: Paths_exference
  main-is: Main.hs
  hs-source-dirs: src-exference
  ghc-options: -rtsopts
               -Wall
               -fno-warn-orphans
               -threaded
               -fno-spec-constr
               -- -fllvm
  if impl(ghc > 8.0)
    ghc-options: -fno-warn-redundant-constraints
  if flag(exference-dev)
    ghc-options: -Werror
                 -auto-all
                 -caf-all
  ghc-options: -with-rtsopts "-H2G -M4G -N"


  default-extensions: NoMonomorphismRestriction
              FlexibleContexts
              ScopedTypeVariables
              TemplateHaskell

Test-Suite exference-tests
  default-language: Haskell2010
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test
  ghc-options: -Wall
  build-depends:
    base,
    containers,
    exference,
    haskell-src-exts,
    multistate,
    tasty,
    tasty-hunit,
    transformers
